      "tempo": 1.0
    },
    "qingping/needles": {
      "text": "飞针！打下来！",
      "engine": "qwen",
      "source": "assets/linyuan/audit/voice/qwen/qingping/needles.wav",
      "file": "assets/linyuan/audio/voice/qingping/needles.wav",
      "sha256": "5ad63fa4f1c8cfd3ff78bd260e50b3f9baf0d220f54e144b320da370ae3ea2c7",
      "seconds": 1.1937,
      "tempo": 1.0
    },
    "qingping/elite_core": {
      "text": "它背上的鳞扇中间，打核心！",
      "engine": "qwen",
      "source": "assets/linyuan/audit/voice/qwen/qingping/elite_core.wav",
      "file": "assets/linyuan/audio/voice/qingping/elite_core.wav",
      "sha256": "3143edd16da807eab833ff151b0b48fa379de5a5bb4500b58d7346586b9fd1fe",
      "seconds": 2.6366,
      "tempo": 1.0
    },
    "qingping/raft": {
      "text": "打断那根藤索！",
      "engine": "qwen",
      "source": "assets/linyuan/audit/voice/qwen/qingping/raft.wav",
      "file": "assets/linyuan/audio/voice/qingping/raft.wav",
      "sha256": "38763218c3faaa67a8719ccd3f3230bcb666dbc1bee97805d28325dc6d709be2",
      "seconds": 1.4379,
      "tempo": 1.0
    },
    "luchen/noodle": {
      "text": "你又没有嘴。",

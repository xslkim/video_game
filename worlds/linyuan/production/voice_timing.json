      "seconds": 1.216,
      "tempo": 1.0492
    },
    "yunyi/talon": {
      "text": "这只手还没用够本呢！",
      "engine": "qwen",
      "source": "assets/linyuan/audit/voice/qwen/yunyi/talon.wav",
      "file": "assets/linyuan/audio/voice/yunyi/talon.wav",

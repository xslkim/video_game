      "seconds": 1.5869,
      "tempo": 1.0
    },
    "yunyi/thanks": {
      "text": "手还在，面也没凉。快去！",
      "engine": "qwen",
      "source": "assets/linyuan/audit/voice/qwen/yunyi/thanks.wav",
      "file": "assets/linyuan/audio/voice/yunyi/thanks.wav",

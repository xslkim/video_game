{
  "lines": {
    "qingping/noodle": {
      "text": "这碗面看起来很好吃。我是说，数据上。",
      "engine": "qwen",
      "source": "assets/linyuan/audit/voice/qwen/qingping/noodle.wav",
      "file": "assets/linyuan/audio/voice/qingping/noodle.wav",
      "sha256": "740977a1a9e207d4eaa3282135911dcabeabfe417aeda84c64fafe82622fafec",
      "seconds": 3.5002,
      "tempo": 1.28
    },
    "qingping/scan": {
      "text": "等它现形，再出剑！",
      "engine": "qwen",
      "source": "assets/linyuan/audit/voice/qwen/qingping/scan.wav",
      "file": "assets/linyuan/audio/voice/qingping/scan.wav",
      "sha256": "51c6f911da0cafed59eb7e56b6a90599e2814703213d28b3a8faf129d0eb77eb",
      "seconds": 1.9968,
      "tempo": 1.0
    },
    "qingping/talon": {
      "text": "打它胸口！",
      "engine": "qwen",
      "source": "assets/linyuan/audit/voice/qwen/qingping/talon.wav",
      "file": "assets/linyuan/audio/voice/qingping/talon.wav",
